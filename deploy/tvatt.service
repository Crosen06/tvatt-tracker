# Template — install.sh fills in @USER@, @REPO@ and @DATA@.
[Unit]
Description=Tvätt-tracker (laundry basket tracker)
After=network-online.target
Wants=network-online.target

[Service]
User=@USER@
# The webcam (/dev/video*) belongs to the video group.
SupplementaryGroups=video
WorkingDirectory=@REPO@/backend
Environment=TVATT_DATA=@DATA@
# Own settings (e.g. TVATT_CAMERA=1, TVATT_CAMERA_SIZE=1280x720, TVATT_VISION_SURE=0.85), one per line.
# Kept in the data folder so updates do not overwrite them; the file is optional.
EnvironmentFile=-@DATA@/tvatt.env
ExecStart=@REPO@/.venv/bin/python -m uvicorn --factory app.main:create_app --host 0.0.0.0 --port 80 --timeout-graceful-shutdown 3
# Allow binding port 80 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
